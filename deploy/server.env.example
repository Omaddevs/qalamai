# Copy to deploy/server.env on the server. DATABASE_URL, STORAGE_DIR, MODELS_DIR and TRUST_PROXY
# are set by docker-compose.yml.
JWT_SECRET=            # openssl rand -hex 32
APP_URL=https://qalamai.uz
CORS_ORIGINS=https://qalamai.uz
LOG_LEVEL=info
BG_MODEL=u2netp
MODELS_AUTO_DOWNLOAD=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_POLLING=true
# QalamChat messages go to this chat through the bot (your user id, or a group id like -100…)
# CONTACT_CHAT_ID=
# First password of the admin panel (https://qalamai.uz/admin); change it from the panel afterwards
# ADMIN_PASSWORD=

# Free photos in the editor: unsplash.com/developers → New Application → Access Key
# (without it the editor falls back to Openverse)
# UNSPLASH_ACCESS_KEY=

# «AI taqdimotçi» Uzbek voice (Aisha: voicelab.uz/app → API keys). AISHA_MALE_VOICE_ID = a cloned man's voice id.
# AISHA_API_KEY=
# AISHA_MALE_VOICE_ID=
# AISHA_MOOD=Neutral

# «AI taqdimotçi» voice for other languages (Azure AI Speech: Speech service → Keys and Endpoint). Without it the browser voice speaks.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# TTS_DAILY_CHARS=60000
