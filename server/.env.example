# ─── QalamAI API ─────────────────────────────────────────────────────────────
# Copy to .env and adjust. Every value has a working development default.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true when running behind nginx / a load balancer
TRUST_PROXY=false

# ─── Database ────────────────────────────────────────────────────────────────
# Production: PostgreSQL. Leave empty in development to use the embedded PGlite.
# DATABASE_URL=postgres://qalam:secret@localhost:5432/qalam
PGLITE_DIR=./data/db

# ─── Storage & models ────────────────────────────────────────────────────────
STORAGE_DIR=./data/storage
MODELS_DIR=./models

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters, e.g. `openssl rand -hex 32`
# JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_DAYS=30
# Secure cookies need HTTPS (defaults to true in production)
# COOKIE_SECURE=true

# ─── Files & jobs ────────────────────────────────────────────────────────────
# Uploads and results are deleted after this many hours (Pro users can keep files)
FILE_TTL_HOURS=24
GUEST_TTL_DAYS=30
# Parallel tool runs (worker threads); default = CPU cores − 1, max 4
# JOB_CONCURRENCY=3
JOB_TIMEOUT_SEC=300

# ─── Background removal ──────────────────────────────────────────────────────
# u2netp (4.6 MB, fast) · silueta (43 MB) · u2net (176 MB) · isnet-general-use (178 MB, best)
BG_MODEL=u2netp
MODELS_AUTO_DOWNLOAD=true

# ─── Optional: Gotenberg (LibreOffice) for pixel-perfect Word → PDF ──────────
# docker run -p 3000:3000 gotenberg/gotenberg:8
# GOTENBERG_URL=http://localhost:3000

# ─── Google bilan kiriş (ixtiyoriy) ──────────────────────────────────────────
# Public address of the web app; Google redirects back to APP_URL/api/v1/auth/google/callback
APP_URL=http://localhost:5173
# Google Cloud Console → Google Auth Platform → Clients → Web application
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# ─── Telegram bot orqali kiriş (ixtiyoriy) ───────────────────────────────────
# @BotFather → /newbot. The bot asks the user to share their own phone number and sends the code.
# TELEGRAM_BOT_TOKEN=
# The API reads bot updates by long polling; run only ONE server instance with polling on.
# TELEGRAM_POLLING=true
# Only if api.telegram.org is unreachable from the server: a proxy / self-hosted Bot API address
# TELEGRAM_API_URL=https://api.telegram.org
# Or keep the URL and connect to another Telegram IP (TLS is still verified), e.g. t.me's address
# TELEGRAM_API_IP=149.154.167.99
